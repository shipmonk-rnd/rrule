includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon
  - vendor/phpstan/phpstan-phpunit/extension.neon
  - vendor/phpstan/phpstan-phpunit/rules.neon
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/shipmonk/dead-code-detector/rules.neon
  - vendor/shipmonk/phpstan-rules/rules.neon

parameters:
  level: max
  tmpDir: cache/phpstan
  checkUninitializedProperties: true
  checkMissingCallableSignature: true
  checkTooWideReturnTypesInProtectedAndPublicMethods: true
  checkBenevolentUnionTypes: true
  reportAnyTypeWideningInVarTag: true
  reportPossiblyNonexistentConstantArrayOffset: true
  reportPossiblyNonexistentGeneralArrayOffset: true

  phpVersion:
    min: 80100
    max: 80599

  paths:
    - coverage-guard.php
    - composer-dependency-analyser.php
    - src
    - tests

  excludePaths:
    analyseAndScan:
      - tests/Type/data/*

  exceptions:
    check:
      missingCheckedExceptionInThrows: true
      tooWideThrowType: true
      throwTypeCovariance: true
    implicitThrows: false
    checkedExceptionClasses:
      - RuntimeException

  shipmonkDeadCode:
    usageExcluders:
      tests:
        enabled: true

  ignoreErrors:
    - identifier: missingType.checkedException
      path: tests/*
    - identifier: staticMethod.alreadyNarrowedType
      path: tests/*
      reportUnmatched: false
    # data providers create values with constructors that throw checked exceptions
    - identifier: shipmonk.checkedExceptionInCallable
      path: tests/*
    - identifier: shipmonk.checkedExceptionInYieldingMethod
      path: tests/*
    # random rule parts are plain integers; the RecurrenceRule constructor checks their ranges
    - identifier: argument.type
      path: tests/Reference/ReferenceCase.php
