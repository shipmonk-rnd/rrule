    },
    {
      "id": "php-rrule-invalid-063",
      "description": "missing RRULE",
      "recurrence": "DTSTART:20060624\nFREQ=DAILY",
      "expectedError": "InvalidArgumentException",
      "notes": null
    },
    {
      "id": "php-rrule-invalid-064",
      "description": "multiple RRULE or DTSTART",
      "recurrence": "DTSTART:20060624\nRRULE:FREQ=DAILY\nRRULE:FREQ=YEARLY",
      "expectedError": "InvalidArgumentException",
      "notes": {
        "info": "php-rrule: the RRule class takes one RRULE; RSet takes several. RFC 5545 section 3.8.5.3 says RRULE \"SHOULD NOT be specified more than once\", so a parser for a recurrence set can accept it."
      }
    },
    {
      "id": "php-rrule-invalid-065",
      "description": "multiple RRULE or DTSTART",
      "recurrence": "DTSTART:20060624\nDTSTART:20060624\nRRULE:FREQ=YEARLY",
      "expectedError": "InvalidArgumentException",
      "notes": null
    },
    {
      "id": "php-rrule-invalid-066",
      "description": "properties for Rset",
      "recurrence": "DTSTART:20060624\nRRULE:FREQ=DAILY\nEXRULE:FREQ=YEARLY",
      "expectedError": "InvalidArgumentException",
      "notes": {
        "info": "php-rrule: the RRule class rejects EXRULE; RSet takes it. RFC 5545 Appendix A.3 says EXRULE \"can no longer be specified in a component\"."
      }
