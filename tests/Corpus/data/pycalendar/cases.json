  "dtStartPolicy": "OnlyIfMatching",
  "cases": [
    {
      "id": "pycalendar-001",
      "description": "rrule_examples.json entry 1: FREQ=YEARLY;BYWEEKNO=1,2",
      "recurrence": "DTSTART:20130101T000000\nRRULE:FREQ=YEARLY;BYWEEKNO=1,2",
      "startAt": null,
      "expected": [
        "20130101T000000",
        "20130108T000000",
        "20140101T000000",
        "20140108T000000",
        "20150101T000000",
        "20150108T000000",
        "20160108T000000",
        "20160115T000000"
      ],
      "expectedError": null,
      "truncated": true,
      "notes": {
        "suspicious": "BYWEEKNO without BYDAY: pycalendar takes the weekday of 1 January of each year (20140101 is a Wednesday, 20160108 a Friday). RFC 5545 takes missing parts from DTSTART (a Tuesday); libical-058 has the same rule and gives Tuesdays.",
        "info": "pycalendar lists every instance in the period [20130101T000000, 20170101T000000)."
      }
    },
