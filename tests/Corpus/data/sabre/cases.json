      "id": "sabre-001",
      "description": "testHourly",
      "recurrence": "DTSTART:20111007T120000Z\nRRULE:FREQ=HOURLY;INTERVAL=3;COUNT=12",
      "startAt": null,
      "expected": [
        "20111007T120000Z",
        "20111007T150000Z",
        "20111007T180000Z",
        "20111007T210000Z",
        "20111008T000000Z",
        "20111008T030000Z",
        "20111008T060000Z",
        "20111008T090000Z",
        "20111008T120000Z",
        "20111008T150000Z",
        "20111008T180000Z",
        "20111008T210000Z"
      ],
      "expectedError": null,
      "truncated": false,
      "notes": null
    },
    {
      "id": "sabre-002",
      "description": "test2HourlyOnDstTransition: On transition start",
      "recurrence": "DTSTART;TZID=Europe/Zurich:20230326T000000\nRRULE:FREQ=HOURLY;INTERVAL=2;COUNT=5",
      "startAt": null,
      "expected": [
        "20230326T000000",
        "20230326T030000",
        "20230326T040000",
        "20230326T060000",
        "20230326T080000"
      ],
      "expectedError": null,
      "truncated": false,
      "notes": {
        "info": "HOURLY counts wall-clock hours; an instance in the DST gap moves forward by the gap length. RFC 5545 does not say whether HOURLY counts wall-clock or elapsed hours."
      }
    },
