{
    "$schema": "tools/infection/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "testFrameworkOptions": "--testsuite=default",
    "logs": {
        "text": "cache/infection.log"
    },
    "tmpDir": "cache/infection",
    "timeout": 60,
    "minMsi": 98,
    "minCoveredMsi": 98,
    "mutators": {
        "@default": true,
        // A LogicException marks a branch that valid states never reach (for example a sub-daily arm in a
        // daily-only match). Mutating such a branch changes nothing that a test can see.
        "global-ignoreSourceCodeByRegex": [".*throw new LogicException\\(.*"]
    }
}
